# ─── 백엔드 서버 환경 변수 ──────────────────────────────────
# 이 파일을 복사해서 .env 로 이름을 바꾼 뒤 값을 채워주세요.
# cp .env.example .env

# 서버 포트 (기본값 그대로 사용)
PORT=4000

# JWT 서명 키 (변경 불필요)
JWT_SECRET=base-nine-jwt-secret-change-in-production

# MySQL 비밀번호 (본인 로컬 MySQL 비밀번호로 변경)
DB_PASSWORD=YOUR_MYSQL_PASSWORD

# QR 서명 키 (변경 불필요)
QR_SECRET=base-nine-qr-secret-2026

# Google OAuth (팀에서 공유받은 값 입력)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://127.0.0.1:5173/

# 시간 오프셋 (0 = 실제 시간, 양수 = N시간 후로 시뮬레이션)
DEBUG_TIME_OFFSET_HOURS=0

# ─── 온체인 NFT 민팅 (변경 불필요) ─────────────────────────
MINTER_PRIVATE_KEY=0x8442d7fe5a2a57c8cb8dc8a31215af481fa08fdaaa189c7249b2b6e568dc0bed
FRAGMENT_NFT_ADDRESS=0x2D9D1B961dD8d3360fD4dFdCd4a5fbD225F5a0bB
TICKET_NFT_ADDRESS=0x7f5Ecb01153DcF9E6E0bB0d644B4CD8a6a142856
BOX_NFT_ADDRESS=0x2B683a0B6A87800eD57250efC654e51b9752D570
