# ─── 프론트엔드 환경 변수 ───────────────────────────────────
# 이 파일을 복사해서 .env 로 이름을 바꾼 뒤 값을 채워주세요.
# cp .env.example .env

# 백엔드 서버 주소 (기본값 그대로 사용)
VITE_API_URL=http://localhost:4000

# Google OAuth 클라이언트 ID (팀에서 공유받은 값 입력)
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID

# 배포된 TicketNFT 컨트랙트 주소 (변경 불필요)
VITE_CONTRACT_ADDRESS=0x7f5Ecb01153DcF9E6E0bB0d644B4CD8a6a142856
